{
  "name": "power-monitor-sensor-agent-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev:test": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "e2e": "playwright test",
    "test": "vitest run",
    "format": "prettier --write src tests e2e *.ts *.html",
    "format:check": "prettier --check src tests e2e *.ts *.html"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.1"
  }
}
