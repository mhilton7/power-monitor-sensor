{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powermonitor.local/schemas/config-v1.schema.json",
  "title": "Power Monitor non-secret configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "config_version", "friendly_name", "hostname",
    "server_url", "connection_mode", "sample_interval_seconds",
    "durable_log_interval_seconds", "heartbeat_interval_seconds",
    "ct_rating_a", "timezone", "sd_spi_hz"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "config_version": {"type": "integer", "minimum": 1},
    "friendly_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "hostname": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "site_id": {"type": "string", "maxLength": 64},
    "circuit_id": {"type": "string", "maxLength": 64},
    "parent_circuit_id": {"type": "string", "maxLength": 64},
    "measurement_role": {"enum": ["main", "service-leg", "branch", "submeter", "other"]},
    "wifi_ssid": {"type": "string", "maxLength": 32},
    "static_network_enabled": {"type": "boolean"},
    "static_ip": {"type": "string", "maxLength": 15},
    "static_gateway": {"type": "string", "maxLength": 15},
    "static_subnet": {"type": "string", "maxLength": 15},
    "static_dns": {"type": "string", "maxLength": 15},
    "server_url": {"type": "string", "pattern": "^(?:$|https://)", "maxLength": 256},
    "server_ca_configured": {"type": "boolean"},
    "server_fingerprint_configured": {"type": "boolean"},
    "connection_mode": {
      "enum": ["pull", "push", "hybrid"],
      "description": "pm-protocol/1.0.0 retains all three values. This firmware currently operates only in push mode and rejects pull or hybrid configuration."
    },
    "allowed_server_addresses": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 253}},
    "live_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "sample_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "pzem_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 5000},
    "durable_log_interval_seconds": {"type": "integer", "minimum": 10, "maximum": 3600},
    "heartbeat_interval_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
    "sync_interval_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
    "sync_retry_max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "ct_rating_a": {"type": "number", "minimum": 1, "maximum": 1000},
    "ct_warning_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "ct_critical_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "ct_fault_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
    "voltage_minimum_v": {"type": "number", "minimum": 0, "maximum": 400},
    "voltage_maximum_v": {"type": "number", "minimum": 0, "maximum": 400},
    "frequency_minimum_hz": {"type": "number", "minimum": 40, "maximum": 70},
    "frequency_maximum_hz": {"type": "number", "minimum": 40, "maximum": 70},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 64},
    "ntp_servers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
    "sd_spi_hz": {"type": "integer", "minimum": 1000000, "maximum": 20000000},
    "storage_warning_free_bytes": {"type": "integer", "minimum": 1048576},
    "retention_enabled": {"type": "boolean"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "local_session_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "ota_channel": {"enum": ["stable", "beta"]},
    "ota_update_window_enabled": {"type": "boolean"},
    "ota_update_window_start_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "ota_update_window_end_hour": {"type": "integer", "minimum": 0, "maximum": 23},
    "diagnostic_log_level": {"type": "integer", "minimum": 0, "maximum": 5}
  }
}
